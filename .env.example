# Credentials for the real-LLM experiment. Two providers are available:
#   - Gemini (src/gemini-provider.ts)
#   - OpenRouter (src/openrouter-provider.ts), model: google/gemma-4-31b-it:free
#
# Copy this file to `.env` in the project root (same folder as package.json)
# and fill in a real key there. `.env` is loaded automatically by
# `npm run eval` (via dotenv) and is gitignored - never commit it, never put
# a real key anywhere else in the repo.
#
# `npm run eval` selects OPENROUTER_API_KEY when present; otherwise it falls
# back to GEMINI_API_KEY when present. When neither is present, it reports
# that no provider is configured and makes no network call - the original
# no-key behavior, unchanged.

OPENROUTER_API_KEY=
GEMINI_API_KEY=
